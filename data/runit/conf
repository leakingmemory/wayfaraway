# Configuration for the wayfaraway runit service.

# The user who owns the desktop. A service named wayfaraway-<user> takes it
# from its name.
#WAYFARAWAY_USER="alice"

# Options for wayfaraway, quoted as on a command line.
#WAYFARAWAY_OPTS="--address 0.0.0.0 --startup 'foot'"

# Runtime directory for the Wayland socket. The default,
# /run/wayfaraway/<user>, is one no login manager touches. /run/user/<uid>
# lets apps on the desktop reach the user's PipeWire and D-Bus, but only if it
# outlives logins (with elogind, `loginctl enable-linger <user>`).
#WAYFARAWAY_RUNTIME_DIR="/run/user/1000"
